<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tool_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background_menu"
        android:elevation="5dp"
        app:title="@string/group_edit"
        app:titleTextAppearance="@style/ToolbarTitle" />

    <!-- 主内容区（高度写死，AS 预览救星） -->
     <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="192dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- 封面 -->
        <io.legado.app.ui.widget.image.CoverImageView
            android:id="@+id/iv_cover"
            android:layout_width="120dp"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:src="@drawable/image_cover_default"
            android:contentDescription="@string/img_cover"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="12dp" />

        <!-- 分组名称 -->
        <io.legado.app.ui.widget.text.TextInputLayout
            android:id="@+id/name_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:hint="@string/group_name"
            android:paddingHorizontal="8dp"
            app:layout_constraintStart_toEndOf="@id/iv_cover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <io.legado.app.lib.theme.view.ThemeEditText
                android:id="@+id/tie_group_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="14sp"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 排序 -->
        <LinearLayout
            android:id="@+id/sort_container"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginStart="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toEndOf="@id/iv_cover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/name_container">

            <io.legado.app.ui.widget.text.AccentTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort"
                android:textSize="14sp"
                android:textColor="@color/primaryText" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/sp_sort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:entries="@array/book_sort"
                android:theme="@style/SpinnerWithSmallText" />
        </LinearLayout>

        <!-- 允许下拉刷新 -->
        <io.legado.app.lib.theme.view.ThemeCheckBox
            android:id="@+id/cb_enable_refresh"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:text="@string/allow_drop_down_refresh"
            android:textSize="13sp"
            android:gravity="center_vertical"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            app:layout_constraintStart_toEndOf="@id/iv_cover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sort_container" />

        <!-- 仅更新已读 -->
        <io.legado.app.lib.theme.view.ThemeCheckBox
            android:id="@+id/cb_enable_only_read"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:text="@string/only_update_read"
            android:textSize="13sp"
            android:gravity="center_vertical"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            app:layout_constraintStart_toEndOf="@id/iv_cover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cb_enable_refresh" />

        <!-- 只显示小说 -->
        <io.legado.app.lib.theme.view.ThemeCheckBox
            android:id="@+id/cb_filter_only_text"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:text="只显示小说"
            android:textSize="13sp"
            android:gravity="center_vertical"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            app:layout_constraintStart_toEndOf="@id/iv_cover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cb_enable_only_read" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 底部按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <io.legado.app.ui.widget.text.AccentTextView
            android:id="@+id/btn_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:padding="6dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <io.legado.app.ui.widget.text.AccentTextView
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:padding="6dp"
            android:layout_marginEnd="16dp" />

        <io.legado.app.ui.widget.text.AccentTextView
            android:id="@+id/btn_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ok"
            android:padding="6dp" />
    </LinearLayout>

</LinearLayout>